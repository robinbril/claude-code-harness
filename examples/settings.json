{
  "_comment_auto_mode": "OPTIONEEL en NIET aanbevolen als default: 'defaultMode: auto' + 'skipAutoPermissionPrompt: true' slaan alle tool-permissie-prompts over. Voeg dit alleen toe als je bewust voor auto-mode kiest, niet door dit blok klakkeloos te mergen.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/hooks/commit-guard.js\""
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Task|EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/tools/worktree-care/hook.mjs\" guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/hooks/verified-claim-guard.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/tools/worktree-care/hook.mjs\" after"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/tools/worktree-care/hook.mjs\" agent-end"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/claude-code-harness/tools/worktree-care/hook.mjs\" session-end"
          }
        ]
      }
    ]
  }
}
